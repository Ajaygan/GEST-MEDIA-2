{
  "manifest_version": 3,
  "name": "GestMedia \u2014 Gesture Media Control",
  "version": "1.1.3",
  "description": "Control media playback on YouTube, JioHotstar/JioCinema, Hotstar and any site with webcam hand gestures. Runs fully on-device.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "GestMedia",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/controller.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": false
    }
  ],
  "commands": {
    "toggle-gestures": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Turn gesture control on/off"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
